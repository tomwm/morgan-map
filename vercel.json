{
  "rewrites": [
    { "source": "/morgan-map/api/:path*",    "destination": "/api/:path*" },
    { "source": "/morgan-map/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/gallery",    "destination": "/index.html" },
    { "source": "/view/:id",   "destination": "/index.html" },
    { "source": "/admin",      "destination": "/index.html" },
    { "source": "/sign-in",    "destination": "/index.html" },
    { "source": "/sign-up",    "destination": "/index.html" }
  ]
}
